rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Exercises Catalog
    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if isValidId(exerciseId);
    }

    // Classes
    match /classes/{classId} {
      allow read: if true;
      allow write: if isValidId(classId);
    }

    // Homework Assignments
    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if isValidId(assignmentId);
    }

    // Student Homework Submissions (Teacher Journal)
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if isValidId(submissionId);
      allow update, delete: if isValidId(submissionId);
    }

    // Workouts & History
    match /workouts/{workoutId} {
      allow read: if true;
      allow create: if isValidId(workoutId);
      allow update, delete: if isValidId(workoutId);
    }
  }
}
